DATABASE_URL=postgresql://tyballs:change-this-password@127.0.0.1:5432/tyballs
PAYLOAD_SECRET=generate-a-long-random-value-before-deployment
PREVIEW_SECRET=generate-a-different-long-random-value-before-deployment
NEXT_PUBLIC_SERVER_URL=https://tyballs.ie
CMS_MEDIA_DIRECTORY=/app/media
CMS_MEDIA_HOST_DIRECTORY=./cms-media
RATE_LIMIT_SALT=generate-a-long-random-value-before-deployment
TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=use-the-secret-from-the-tyballs-turnstile-widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=use-the-public-key-from-the-tyballs-turnstile-widget
SMTP_ENABLED=true
SMTP_HOST=use-the-transactional-email-smtp-host
SMTP_PORT=587
SMTP_USER=use-the-transactional-email-smtp-user
SMTP_PASSWORD=use-the-transactional-email-smtp-password
SMTP_FROM=TYBalls.ie <noreply@tyballs.ie>
SMTP_REQUIRE_TLS=true
ENQUIRY_NOTIFICATION_EMAIL=info@debsguru.ie
NEXT_PUBLIC_GTM_ID=
ENQUIRY_RETENTION_MONTHS=18
SUBMISSION_WINDOW_RETENTION_HOURS=48
RETENTION_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
BACKUP_HOST_DIRECTORY=./backups
