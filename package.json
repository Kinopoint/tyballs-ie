    "@payloadcms/richtext-lexical": "3.87.1",
    "graphql": "16.11.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "nodemailer": "9.0.3",
    "payload": "3.87.1",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
