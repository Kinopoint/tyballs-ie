    "@types/react-dom": "19.2.3",
    "@types/smtp-server": "3.5.13",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "smtp-server": "3.19.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "esbuild": "0.28.2",
